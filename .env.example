# Chore Coin runtime env — copy to .env and fill in the values.
# The .env file is gitignored; never commit real secrets.

# ---- Frontend build-time (baked into the JS bundle by Vite) --------------
# Used to compute daily boundaries for the base-chore "did you finish
# everything today?" check. Any IANA timezone works.
VITE_LOCAL_TIMEZONE=America/Chicago

# ---- Web Push VAPID keys (RFC 8292) --------------------------------------
# Generate a fresh keypair once with:
#   docker compose run --rm webpush npm run generate-vapid
# The public key is served to browsers via /api/custom/push-vapid-key so they
# can subscribe. The private key stays with the webpush sidecar to sign
# outgoing pushes. Never share the private key.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@chorecoin.local

# ---- Shared secret between PocketBase and the webpush sidecar ------------
# Random string, 32+ hex chars recommended. Generate with:
#   openssl rand -hex 32
WEBPUSH_SHARED_SECRET=

# ---- Optional: ntfy fallback ---------------------------------------------
# Leave NTFY_TOPIC blank to disable. Only used if you want push notifications
# via ntfy.sh in addition to (or instead of) native Web Push.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
